// Elzayko data model.
// Auth tables (User, Session, Account, Verification, AuthRateLimit) follow Better Auth's core schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("viewer")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  media         Media[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Better Auth's own rate-limit store (login and auth endpoints).
model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limits")
}

// ─── Content ─────────────────────────────────────────────────────────────────

enum MediaType {
  IMAGE
  VIDEO
  LINK
}

enum SourceType {
  UPLOAD
  EXTERNAL
}

enum MediaStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Media {
  id          String      @id @default(cuid())
  title       String      @db.VarChar(160)
  slug        String      @unique @db.VarChar(180)
  description String?     @db.Text
  caption     String?     @db.VarChar(300)
  altText     String?     @db.VarChar(300)
  mediaType   MediaType
  sourceType  SourceType
  status      MediaStatus @default(DRAFT)
  featured    Boolean     @default(false)
  /// Only honoured for published, uploaded images (also enforced by a CHECK constraint).
  allowDownload Boolean   @default(false)

  // Uploaded assets. `storageKey` is the private original; derivatives are public-readable.
  storageKey   String? @unique
  displayKey   String?
  thumbnailKey String?
  posterKey    String?
  blurDataUrl  String? @db.Text
  mimeType     String? @db.VarChar(100)
  fileSize     Int?
  width        Int?
  height       Int?
  /// Duration in seconds (videos).
  duration     Int?

  // External assets.
  provider     String? @db.VarChar(40)
  externalId   String? @db.VarChar(200)
  externalUrl  String? @db.VarChar(2048)
  thumbnailUrl String? @db.VarChar(2048)

  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId    String?
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags        MediaTag[]
  collections CollectionItem[]
  coverOf     Collection[]     @relation("CollectionCover")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, mediaType, publishedAt(sort: Desc)])
  @@index([status, featured])
  @@index([categoryId, status])
  @@index([createdAt(sort: Desc)])
  @@map("media")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(80)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0)
  media       Media[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("categories")
}

model Collection {
  id          String           @id @default(cuid())
  title       String           @db.VarChar(120)
  slug        String           @unique @db.VarChar(140)
  description String?          @db.VarChar(1000)
  featured    Boolean          @default(false)
  isPublic    Boolean          @default(true)
  sortOrder   Int              @default(0)
  coverId     String?
  cover       Media?           @relation("CollectionCover", fields: [coverId], references: [id], onDelete: SetNull)
  items       CollectionItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isPublic, sortOrder])
  @@map("collections")
}

model CollectionItem {
  collectionId String
  mediaId      String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  media        Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([collectionId, mediaId])
  @@index([mediaId])
  @@map("collection_items")
}

model Tag {
  id    String     @id @default(cuid())
  name  String     @db.VarChar(60)
  slug  String     @unique @db.VarChar(80)
  media MediaTag[]

  @@map("tags")
}

model MediaTag {
  mediaId String
  tagId   String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId])
  @@map("media_tags")
}

/// Editable static pages (about, contact, privacy, terms). `content` is validated per slug with Zod.
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(60)
  title     String   @db.VarChar(160)
  content   Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("pages")
}

/// Singleton row (id = 1, enforced by CHECK constraint).
model SiteSettings {
  id           Int      @id @default(1)
  siteName     String   @db.VarChar(80)
  tagline      String   @db.VarChar(160)
  description  String   @db.VarChar(300)
  heroHeading  String   @db.VarChar(160)
  heroIntro    String   @db.VarChar(600)
  contactEmail String?  @db.VarChar(254)
  location     String?  @db.VarChar(120)
  /// Array of { platform, url } validated with Zod.
  socialLinks  Json     @default("[]")
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

enum SubmissionStatus {
  NEW
  READ
  ARCHIVED
}

model ContactSubmission {
  id             String           @id @default(cuid())
  name           String           @db.VarChar(120)
  email          String           @db.VarChar(254)
  subject        String           @db.VarChar(160)
  message        String           @db.Text
  /// Salted SHA-256 of the sender IP; raw IPs are never stored.
  ipHash         String?          @db.VarChar(64)
  userAgent      String?          @db.VarChar(300)
  status         SubmissionStatus @default(NEW)
  emailDelivered Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@map("contact_submissions")
}

/// Fixed-window counters for application rate limits (contact, uploads, downloads, login).
model RateLimitBucket {
  key       String   @id @db.VarChar(200)
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
