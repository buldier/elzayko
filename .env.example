# ─── Core ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/elzayko?schema=public"
# Public base URL (canonical links, sitemap, auth). Use https:// in production.
SITE_URL="http://localhost:3000"
# 32+ random characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=""

# ─── Admin account (used by `npm run db:seed` only) ──────────────────────────
ADMIN_EMAIL="you@example.com"
# At least 12 characters.
ADMIN_PASSWORD=""
ADMIN_NAME="Your Name"

# ─── Storage ─────────────────────────────────────────────────────────────────
# "local" (filesystem, dev / single server) or "s3" (AWS S3, Cloudflare R2, MinIO…).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# Required when STORAGE_DRIVER=s3. The bucket must stay private; expose only the
# derivatives/ prefix through S3_PUBLIC_BASE_URL (CDN or public bucket path).
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""            # optional: R2 / MinIO endpoint
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""     # e.g. https://media.example.com
S3_FORCE_PATH_STYLE="false"

# ─── Email (contact form notifications) ─────────────────────────────────────
# "console" logs messages (development); "resend" sends via https://resend.com.
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM=""             # e.g. "Elzayko <hello@yourdomain.com>" (verified domain)
CONTACT_RECIPIENT=""      # optional; defaults to the contact email in Settings

# ─── Networking ──────────────────────────────────────────────────────────────
# Headers trusted for the client IP (rate limiting). Match your host / proxy.
TRUSTED_IP_HEADERS="x-forwarded-for,x-real-ip"

# ─── Tests ───────────────────────────────────────────────────────────────────
# Integration tests TRUNCATE every table here; the database name must end in _test.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/elzayko_test?schema=public"
# Seed without network (generated artwork instead of sample photographs).
SEED_OFFLINE="0"
